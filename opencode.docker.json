{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "exec ${CODEBASE_MEMORY_MCP_SERVER_COMMAND:-codebase-memory-mcp}"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "plugin": [
    "./.opencode/plugins/codebase-memory-hooks.ts"
  ],
  "instructions": [
    "AGENTS.md",
    "docs/architecture/README.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".opencode-container/**",
      ".codebase-memory/**",
      "dist/**",
      "build/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      ".mypy_cache/**",
      "docs/architecture/rendered/**"
    ]
  },
  "default_agent": "orchestrator",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "doom_loop": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".opencode-container/**": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".opencode-container/**": "deny",
      ".git/**": "deny"
    },
    "bash": {
      "*": "allow",

      "git push*": "deny",
      "git commit*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git restore*": "deny",
      "git checkout --*": "deny",
      "git rebase*": "deny",
      "git rm*": "deny",
      "git branch -D*": "deny",

      "gh *": "deny",
      "sudo *": "deny",

      "*.opencode-container*": "deny"
    }
  }
}